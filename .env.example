# Copy to .env.local for local development. On Vercel, set each one per environment.

# ── Google service account (Sheets + Drive) ────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=parking-tickets@your-project.iam.gserviceaccount.com
# The "private_key" value from the JSON key, on one line with literal \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# From the Sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=
# Tab name (default: Tickets)
GOOGLE_SHEET_TAB=Tickets
# Folder inside a Shared Drive: drive.google.com/drive/folders/<ID>
GOOGLE_DRIVE_FOLDER_ID=

# ── Dashboard auth (Google OAuth) ──────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated; only these accounts can open /dashboard
DASHBOARD_ADMINS=dsandoval@dneroapp.com

# Optional — defaults to https://parking.dneroapp.com
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
